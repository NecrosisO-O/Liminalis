POSTGRES_USER=liminalis
POSTGRES_PASSWORD=change-me-generate-a-long-random-password
POSTGRES_DB=liminalis
POSTGRES_HOST_PORT=127.0.0.1:5432

LIMINALIS_VERSION=latest
LIMINALIS_API_IMAGE=ghcr.io/necrosiso-o/liminalis-api
LIMINALIS_WEB_IMAGE=ghcr.io/necrosiso-o/liminalis-web
LIMINALIS_ADMIN_IMAGE=ghcr.io/necrosiso-o/liminalis-admin

# Used by local npm scripts and by one-off docker compose migration commands.
DATABASE_URL=postgresql://liminalis:change-me-generate-a-long-random-password@127.0.0.1:5432/liminalis?schema=public

WEB_PORT=8080
ADMIN_PORT=8081
API_PORT=3000

PUBLIC_APP_URL=http://localhost:8080
PUBLIC_ADMIN_URL=http://localhost:8081
PUBLIC_API_URL=http://localhost:8080

SESSION_SECRET=change-me-generate-a-long-random-secret
PAIRING_CODE_LENGTH=6

# Production deployments should set these before running npm run prisma:seed.
SEED_ADMIN_USERNAME=owner
SEED_ADMIN_EMAIL=owner@liminalis.local
SEED_ADMIN_PASSWORD=change-me-before-seeding

# Used by the local API process. Docker Compose stores files in its storage volume.
STORAGE_ROOT=.liminalis-storage
